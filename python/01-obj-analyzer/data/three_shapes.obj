# Три тела в одном файле, единицы — мм.
# Проверяет: несколько объектов, имена из нескольких слов, сквозную нумерацию вершин,
# все форматы граней (v, v/vt, v//vn, v/vt/vn), грани с 3, 4 и 6 вершинами,
# пропуск неподдерживаемых директив (mtllib, usemtl, s, g).
mtllib three_shapes.mtl

# ---------- Общие текстурные координаты ----------
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# ---------- Общие нормали ----------
vn 0 0 -1
vn 0 0 1
vn 0 -1 0
vn 0.7071 -0.7071 0
vn 0.7071 0.7071 0
vn 0 1 0
vn -0.7071 0.7071 0
vn -0.7071 -0.7071 0

# ---------- 1. Брусок 20 x 10 x 5 ----------
o Брусок 20x10x5
v 0 0 0
v 20 0 0
v 20 10 0
v 0 10 0
v 0 0 5
v 20 0 5
v 20 10 5
v 0 10 5
usemtl steel
s off
f 1 4 3 2
f 5 6 7 8
f 1 2 6 5
f 4 8 7 3
f 1 5 8 4
f 2 3 7 6

